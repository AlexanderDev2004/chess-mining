# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# uv
# uv.lock IS committed (reproducible builds)

# Testing / linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Data — raw downloads and pipeline output stay out of git.
# Folder structure is kept via .gitkeep files.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Amp scratch files
.amp/
